[{"id":"chile","category":"國家地理","title":"世界最狹長的國家","place":"智利","value":"4,300","unit":"km 南北長度","text":"按國土長寬比例比較，金氏世界紀錄列智利為最狹長國家。平均寬約 175 公里；智利政府採約 180 公里的近似值。狹長的國土沿安地斯山與太平洋延伸，從北方沙漠一路走向南方峽灣。","countries":["CHL"],"source":"https://www.guinnessworldrecords.com/world-records/90899-narrowest-country"},{"id":"russia","category":"國家地理","title":"面積最大的國家","place":"俄羅斯","value":"1,710","unit":"萬 km² 約值","text":"按國家總面積比較，俄羅斯為全球最大，疆域橫跨歐洲與亞洲。","countries":["RUS"],"source":"https://www.britannica.com/place/Russia"},{"id":"vatican","category":"國家地理","title":"面積最小的國家","place":"梵蒂岡","value":"0.44","unit":"km²","text":"按梵蒂岡政府公布的領土面積，約為 44 公頃。這個獨立國家位於羅馬城內。部分資料庫採用不同約值，此處以官方地理頁面為準。","countries":["VAT"],"source":"https://www.vaticanstate.va/en/state-and-government/general-informations/geography.html"},{"id":"india","category":"國家地理","title":"人口最多的國家","place":"印度","value":"2023","unit":"年超越中國","text":"聯合國估計印度於 2023 年超越中國，成為人口最多的國家。這是人口排名資訊，不代表下方資料卡的歷史人口快照是當前人口。","countries":["IND"],"source":"https://www.un.org/development/desa/pd/content/india-overtakes-china-world%E2%80%99s-most-populous-country"},{"id":"canada","category":"國家地理","title":"海岸線最長的國家","place":"加拿大","value":"3","unit":"大洋環繞","text":"加拿大海岸連接大西洋、北極海與太平洋。海岸線包含眾多島嶼；實際長度因測量比例尺與採計範圍而異。","countries":["CAN"],"source":"https://www.canada.ca/en/services/environment/our-environment/nature-based-climate-solutions/coastlines.html"},{"id":"greenland","category":"國家地理","title":"世界最大的島嶼","place":"格陵蘭","value":"約 217","unit":"萬 km²","text":"排除被視為大陸的澳洲，格陵蘭是最大的島嶼。格陵蘭是丹麥王國內的自治地區，不是獨立國家。","countries":["GRL"],"source":"https://www.guinnessworldrecords.com/world-records/largest-island"},{"id":"everest","category":"山川水域","title":"海拔最高的山峰","place":"聖母峰","value":"8,848.86","unit":"m 海拔","text":"位於中國與尼泊爾邊界，採用 2020 年兩國共同公布的海拔高度。「海拔最高」與從山腳或海底量起的山體高度不同。","countries":["NPL","CHN"],"source":"https://www.guinnessworldrecords.com/world-records/highest-mountain"},{"id":"maunakea","category":"山川水域","title":"從海底量起最高的山","place":"冒納凱阿火山","value":"約 10,205","unit":"m 海底至山頂","text":"夏威夷的冒納凱阿火山，從海底山基量到山頂約超過一萬公尺；大部分山體在水下。這與聖母峰的海拔紀錄採用不同基準。","countries":["USA"],"source":"https://www.guinnessworldrecords.com/world-records/tallest-mountain"},{"id":"baikal","category":"山川水域","title":"世界最深的湖泊","place":"貝加爾湖","value":"1,642","unit":"m 最大深度","text":"位於俄羅斯西伯利亞的裂谷湖。這裡的深度指湖面至湖底，而非湖底的海拔。","countries":["RUS"],"source":"https://www.guinnessworldrecords.com/world-records/deepest-lake"},{"id":"baikalvolume","category":"山川水域","title":"儲水量最大的淡水湖","place":"貝加爾湖","value":"約 23,000","unit":"km³ 淡水","text":"按水體體積比較，貝加爾湖為最大的淡水湖，約含全球未凍結地表淡水的五分之一；按表面積比較則是另一種排名。","countries":["RUS"],"source":"https://pubs.usgs.gov/fs/baikal/index.html"},{"id":"caspian","category":"山川水域","title":"面積最大的內陸水體","place":"裏海","value":"5","unit":"個沿岸國家","text":"雖然名稱叫「海」，裏海是封閉的內陸鹹水體。沿岸為俄羅斯、哈薩克、土庫曼、伊朗與亞塞拜然，水位與面積會隨時間變化。","countries":["RUS","KAZ","TKM","IRN","AZE"],"source":"https://science.nasa.gov/earth/earth-observatory/caspian-sea-44253/"},{"id":"angel","category":"山川水域","title":"最高的瀑布","place":"安赫爾瀑布","value":"979","unit":"m 總落差","text":"位於委內瑞拉卡奈瑪國家公園，金氏世界紀錄列總落差 979 公尺，最大單段落差 807 公尺。瀑布排名會受分段與測量方法影響。","countries":["VEN"],"source":"https://www.guinnessworldrecords.com/world-records/highest-waterfall"},{"id":"challenger","category":"山川水域","title":"已知最深的海洋地點","place":"挑戰者深淵","value":"約 10,935","unit":"m 深度","text":"位於西太平洋馬里亞納海溝。此處採 NOAA Ocean Exploration 的約值，不同航次與測量方法會得出略有差異的深度。","countries":["GUM","MNP"],"source":"https://oceanexplorer.noaa.gov/ocean-fact/ocean-depth/"},{"id":"pacific","category":"自然生態","title":"面積最大的海洋","place":"太平洋","value":"逾 1.55","unit":"億 km²","text":"太平洋是面積最大、也最深的海洋盆地，橫跨亞洲、大洋洲與美洲之間。它跨越多國海域，不屬於單一國家。","countries":[],"source":"https://oceanexplorer.noaa.gov/ocean-fact/pacific-size/"},{"id":"antarctica","category":"自然生態","title":"面積最大的沙漠","place":"南極極地沙漠","value":"約 1,400","unit":"萬 km²","text":"沙漠以降水稀少定義，不一定炎熱或多沙。南極因此是最大的沙漠；它不是國家，也不能歸屬為單一國家的領土。","countries":["ATA"],"source":"https://education.nationalgeographic.org/resource/deserts/"},{"id":"sahara","category":"自然生態","title":"面積最大的熱沙漠","place":"撒哈拉沙漠","value":"約 940","unit":"萬 km²","text":"位於北非，跨越多個國家。這項紀錄限於熱沙漠；若包括極地沙漠，最大的沙漠是南極。面積會依地理界定與時間而異。","countries":["DZA","EGY","LBY","TCD","NER","MLI","MRT","SDN"],"source":"https://education.nationalgeographic.org/resource/deserts/"},{"id":"uyuni","category":"自然生態","title":"世界最大的鹽沼","place":"烏尤尼鹽沼","value":"高原","unit":"鹽地景觀","text":"位於玻利維亞西南部安地斯高原，由古代湖泊演變而成。雨季淺水覆蓋時，鹽沼會映照天空，因此有「天空之鏡」之稱。","countries":["BOL"],"source":"https://science.nasa.gov/earth/earth-observatory/salar-de-uyuni-bolivia-6096/"},{"id":"reef","category":"自然生態","title":"最大的珊瑚礁生態系","place":"大堡礁","value":"澳洲","unit":"東北沿岸","text":"由眾多珊瑚礁、島嶼及海洋棲地組成，並非單一塊珊瑚。聯合國教科文組織將其列為世界最大的珊瑚礁生態系。","countries":["AUS"],"source":"https://whc.unesco.org/en/list/154/"},{"id":"sundarbans","category":"自然生態","title":"世界最大的紅樹林","place":"孫德爾本斯","value":"2","unit":"國交界","text":"位於印度與孟加拉的恆河—布拉馬普特拉河三角洲。潮汐、河流與森林共同形塑這片獨特的濱海生態系。","countries":["BGD","IND"],"source":"https://www.unesco.org/en/articles/sundarbans?hub=752"},{"id":"burj","category":"人文建築","title":"世界最高的建築","place":"哈里發塔","value":"828","unit":"m 建築高度","text":"位於阿拉伯聯合大公國杜拜。此項採金氏世界紀錄的建築高度，而非最高使用樓層或觀景台高度。","countries":["ARE"],"source":"https://www.guinnessworldrecords.com/world-records/tallest-building"},{"id":"lapaz","category":"人文建築","title":"海拔最高的行政首都","place":"拉巴斯","value":"3,631","unit":"m 約海拔","text":"玻利維亞的政府所在地與行政首都。玻利維亞的憲法首都是蘇克雷，因此這項紀錄需附行政首都的定義。市區不同地點的海拔也不同。","countries":["BOL"],"source":"https://www.guinnessworldrecords.com/world-records/65059-highest-capital"},{"id":"tanggula","category":"人文建築","title":"海拔最高的鐵路車站","place":"唐古拉站","value":"5,068","unit":"m 海拔","text":"位於中國青藏鐵路。這是鐵路車站的海拔紀錄，不代表全球所有交通設施的最高點。","countries":["CHN"],"source":"https://www.guinnessworldrecords.com/world-records/highest-railway-station"},{"id":"palace","category":"人文建築","title":"最大的住宅宮殿","place":"努洛伊曼皇宮","value":"汶萊","unit":"斯里巴加灣市附近","text":"金氏世界紀錄列為最大的住宅宮殿。這項分類指作為居所的宮殿，與最大古代宮殿群或建築群面積不同。","countries":["BRN"],"source":"https://www.guinnessworldrecords.com/world-records/largest-residential-palace"},{"id":"potala","category":"人文建築","title":"海拔最高的宮殿","place":"布達拉宮","value":"約 3,700","unit":"m 海拔","text":"位於中國西藏拉薩。金氏世界紀錄列其為海拔最高的宮殿；海拔為近似值，隨建築基準點不同而異。","countries":["CHN"],"source":"https://www.guinnessworldrecords.com/world-records/106956-highest-altitude-palace"}]